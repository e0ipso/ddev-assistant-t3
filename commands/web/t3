#!/bin/bash

## Description: Manage T3 Code in the DDEV web container
## Usage: t3 start [-- <extra t3 serve args>] | t3 pair [--base-url <url>] [--ttl <duration>] [--label <label>] | t3 status | t3 stop | t3 restart
## Example: "ddev t3 start", "ddev t3 pair" or "ddev t3 status"

#ddev-generated

set -euo pipefail

DDEV_CONFIG_DIR="${DDEV_CONFIG_DIR:-/mnt/ddev_config}"
DDEV_APPROOT_DIR="${DDEV_APPROOT_DIR:-/var/www/html}"

usage() {
  cat <<'EOF'
Usage:
  ddev t3 start [-- <extra t3 serve args>]
  ddev t3 pair [--base-url <url>] [--ttl <duration>] [--label <label>]
  ddev t3 status
  ddev t3 stop
  ddev t3 restart
  ddev t3 help

Commands:
  start    Run "t3 serve" in the web container foreground. With
           ASSISTANT_T3_AUTOSTART=true, T3 already runs as a DDEV daemon, so
           start only starts that daemon again if it was stopped.
  pair     Print a pairing link for the running T3 that uses the project URL,
           https://<project>.ddev.site:<https-port>, instead of the container IP
  status   Show whether T3 is running, and how
  stop     Stop the T3 daemon until the next "ddev restart" or "ddev t3 start"
  restart  Restart the T3 daemon
  help     Show this help

Pair options:
  --base-url <url>    Address to put in the link instead of the project URL, for
                      example http://<machine>.<tailnet>.ts.net:<direct-port>
  --ttl <duration>    How long the token stays valid, for example 15m (T3's default: 5m)
  --label <label>     Name shown in T3's connections list
EOF
}

read_env_var() {
  local key="$1"
  local env_file="${DDEV_CONFIG_DIR}/.env.assistant-t3"

  [ -f "${env_file}" ] || return 0
  awk -v key="${key}" '
    BEGIN { FS = "=" }
    $1 == key {
      value = substr($0, index($0, "=") + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      gsub(/^"|"$/, "", value)
      gsub(/^'\''|'\''$/, "", value)
      print value
      exit
    }
  ' "${env_file}"
}

read_direct_publishes() {
  local compose_file="${DDEV_CONFIG_DIR}/docker-compose.assistant-t3.yaml"

  [ -f "${compose_file}" ] || return 0
  awk -F'"' '/^[[:space:]]*-[[:space:]]*"/ { print $2 }' "${compose_file}"
}

read_ddev_config_port() {
  local key="$1"
  local config_file="${DDEV_CONFIG_DIR}/config.assistant-t3.yaml"

  [ -f "${config_file}" ] || return 0
  awk -v key="${key}" '
    $1 == key ":" {
      print $2
      exit
    }
  ' "${config_file}"
}

validate_port() {
  local name="$1"
  local port="$2"

  case "${port}" in
    ''|*[!0-9]*)
      echo "assistant-t3: ${name} must be a numeric TCP port, got '${port}'" >&2
      exit 1
      ;;
  esac

  if [ "${port}" -lt 1 ] || [ "${port}" -gt 65535 ]; then
    echo "assistant-t3: ${name} must be between 1 and 65535, got '${port}'" >&2
    exit 1
  fi
}

calculate_default_ports() {
  local sitename="${DDEV_SITENAME:-${DDEV_PROJECT:-}}"

  if [ -z "${sitename}" ]; then
    echo "assistant-t3: DDEV_SITENAME is not available; cannot calculate default ports" >&2
    exit 1
  fi

  local hash offset
  hash="$(printf '%s' "${sitename}" | cksum | awk '{print $1}')"
  offset="$(( (hash % 4500) * 2 ))"
  ASSISTANT_T3_DEFAULT_HTTP_PORT="$(( 20000 + offset ))"
  ASSISTANT_T3_DEFAULT_HTTPS_PORT="$(( ASSISTANT_T3_DEFAULT_HTTP_PORT + 1 ))"
}

# Docker creates the T3 state volume owned by root. Hand its root to the web
# container user once, so T3 can write its state there.
ensure_state_dir_writable() {
  local state_dir="/mnt/ddev-global-cache/assistant-t3"

  [ -d "${state_dir}" ] || return 0
  [ -w "${state_dir}" ] && return 0
  if ! sudo -n chown "$(id -u):$(id -g)" "${state_dir}"; then
    echo "assistant-t3: ${state_dir} is not writable and changing its owner failed" >&2
    exit 1
  fi
}

t3_runtime_home() {
  local sitename="${DDEV_SITENAME:-${DDEV_PROJECT:-default}}"
  printf '%s\n' "${ASSISTANT_T3_RUNTIME_DIR:-/mnt/ddev-global-cache/assistant-t3/${sitename}}"
}

prepare_t3_home() {
  # DDEV mounts /mnt/ddev_config read-only. T3 saves settings.json by writing a
  # temp file next to the symlink target, so link to the writable app root copy.
  local t3_config_dir="${DDEV_APPROOT_DIR}/.ddev/t3"
  local t3_runtime_home
  t3_runtime_home="$(t3_runtime_home)"
  local t3_runtime_userdata="${t3_runtime_home}/userdata"
  local settings_file="${t3_config_dir}/settings.json"
  local settings_link="${t3_runtime_userdata}/settings.json"

  ensure_state_dir_writable
  mkdir -p "${t3_config_dir}" "${t3_runtime_userdata}"
  if [ ! -f "${settings_file}" ]; then
    cat > "${settings_file}" <<'EOF'
{
  "defaultThreadEnvMode": "local",
  "newWorktreesStartFromOrigin": false
}
EOF
  fi

  if [ -e "${settings_link}" ] && [ ! -L "${settings_link}" ]; then
    echo "assistant-t3: ${settings_link} exists and is not a symlink; refusing to hide user data" >&2
    exit 1
  fi

  ln -sfn "${settings_file}" "${settings_link}"
  T3CODE_RUNTIME_HOME="${t3_runtime_home}"
}

# Add the DDEV app root as a T3 project once per state volume, so a fresh T3
# opens on this project rather than an empty list. The marker keeps a project
# the user removed or archived from coming back: "t3 project add" would create
# a removed one again and unarchive an archived one. Deleting only T3's
# database leaves the marker behind, so that project is not added again.
# Call after T3CODE_HOME is exported: the npm launcher downloads its runtime
# there and ignores --base-dir. "t3 project add" exists since 0.0.16; on older
# versions, and on any other failure, warn and retry on the next start.
seed_project() {
  local marker="${T3CODE_HOME}/.ddev-project-seeded"
  local title="${DDEV_SITENAME:-${DDEV_PROJECT:-$(basename "${DDEV_APPROOT_DIR}")}}"
  local output

  [ -e "${marker}" ] && return 0

  # T3 prints its errors on stdout, so capture both streams.
  if output="$(t3 project add "${DDEV_APPROOT_DIR}" --title "${title}" --base-dir "${T3CODE_HOME}" --log-level warn 2>&1)"; then
    echo "assistant-t3: added ${DDEV_APPROOT_DIR} to T3 as project '${title}'"
    touch "${marker}"
  # T3 prints "An active project already exists for '<path>'." when the
  # project is there already. If a release rewords it, this warns every start.
  elif [[ "${output}" == *"already exists"* ]]; then
    touch "${marker}"
  else
    echo "assistant-t3: could not add ${DDEV_APPROOT_DIR} to T3 as a project; will retry on the next start" >&2
    printf '%s\n' "${output%%$'\n'*}" >&2
  fi
}

# T3 only uses Node.js to run its npm launcher, so check the container's Node.js
# against the engines field of the installed t3 package rather than a list kept
# here. Releases 0.0.41 to 0.1.0 don't declare one, so they get no check. If
# the check itself can't run, let T3 start.
check_node_version() {
  node - "$(npm root --global 2>/dev/null)" <<'EOF' || exit 1
const fs = require("fs");
const path = require("path");
const npmRoot = process.argv[2];
let pkg, semver;
try {
  pkg = JSON.parse(fs.readFileSync(path.join(npmRoot, "t3", "package.json"), "utf8"));
  semver = require(path.join(npmRoot, "npm", "node_modules", "semver"));
} catch (error) {
  console.error(`assistant-t3: could not check which Node.js versions T3 supports, so starting it anyway: ${error.message.split("\n")[0]}`);
  process.exit(0);
}
const range = pkg.engines && pkg.engines.node;
if (range && !semver.satisfies(process.versions.node, range, { includePrerelease: true })) {
  console.error(`assistant-t3: T3 ${pkg.version} needs Node.js ${range}, but the web container has ${process.version}. Change nodejs_version in .ddev/config.yaml and run "ddev restart".`);
  process.exit(1);
}
EOF
}

require_t3() {
  if ! command -v t3 >/dev/null 2>&1; then
    cat >&2 <<'EOF'
assistant-t3: T3 is not available in the web container.

Run "ddev restart" to rebuild the web image after installing the add-on.
If the rebuild already ran, inspect the web image build output for the T3 npm install failure.
EOF
    exit 1
  fi
}

# Sets ASSISTANT_T3_CONTAINER_PORT_RESOLVED, ASSISTANT_T3_HTTP_PORT_RESOLVED and
# ASSISTANT_T3_HTTPS_PORT_RESOLVED from the generated DDEV config, then the env
# file, then the defaults calculated from the project name.
resolve_ports() {
  local env_container_port env_http_port env_https_port
  local config_container_port config_http_port config_https_port

  calculate_default_ports

  env_container_port="$(read_env_var ASSISTANT_T3_CONTAINER_PORT)"
  env_http_port="$(read_env_var ASSISTANT_T3_HTTP_PORT)"
  env_https_port="$(read_env_var ASSISTANT_T3_HTTPS_PORT)"

  config_container_port="$(read_ddev_config_port container_port)"
  config_http_port="$(read_ddev_config_port http_port)"
  config_https_port="$(read_ddev_config_port https_port)"

  ASSISTANT_T3_CONTAINER_PORT_RESOLVED="${config_container_port:-${env_container_port:-3773}}"
  ASSISTANT_T3_HTTP_PORT_RESOLVED="${config_http_port:-${env_http_port:-${ASSISTANT_T3_DEFAULT_HTTP_PORT}}}"
  ASSISTANT_T3_HTTPS_PORT_RESOLVED="${config_https_port:-${env_https_port:-${ASSISTANT_T3_DEFAULT_HTTPS_PORT}}}"

  validate_port "ASSISTANT_T3_CONTAINER_PORT" "${ASSISTANT_T3_CONTAINER_PORT_RESOLVED}"
  validate_port "ASSISTANT_T3_HTTP_PORT" "${ASSISTANT_T3_HTTP_PORT_RESOLVED}"
  validate_port "ASSISTANT_T3_HTTPS_PORT" "${ASSISTANT_T3_HTTPS_PORT_RESOLVED}"

  if [ "${ASSISTANT_T3_HTTP_PORT_RESOLVED}" = "${ASSISTANT_T3_HTTPS_PORT_RESOLVED}" ]; then
    echo "assistant-t3: ASSISTANT_T3_HTTP_PORT and ASSISTANT_T3_HTTPS_PORT must differ" >&2
    exit 1
  fi
}

project_hostname() {
  local hostname="${DDEV_SITENAME:-${DDEV_PROJECT:-}}.ddev.site"

  if [ "${hostname}" = ".ddev.site" ]; then
    echo "assistant-t3: DDEV_SITENAME is not available; cannot print project URLs" >&2
    exit 1
  fi
  printf '%s\n' "${hostname}"
}

# Percent-encodes like the URLSearchParams T3 uses for its app links: only
# ASCII letters, digits and "*-._" stay as they are.
form_url_encode() {
  local value="$1" encoded="" char i
  local LC_ALL=C

  for (( i = 0; i < ${#value}; i++ )); do
    char="${value:i:1}"
    case "${char}" in
      [A-Za-z0-9*._-]) encoded+="${char}" ;;
      ' ') encoded+='+' ;;
      *) encoded+="$(printf '%%%02X' "'${char}")" ;;
    esac
  done
  printf '%s\n' "${encoded}"
}

validate_base_url() {
  local base_url="$1"

  if ! printf '%s' "${base_url}" | grep -Eq '^https?://([A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?|\[[0-9A-Fa-f:.]+\])(:[0-9]{1,5})?$'; then
    echo "assistant-t3: --base-url must look like http(s)://host[:port] with no path, got '${base_url}'" >&2
    exit 1
  fi
}

# T3 builds its pairing link from the first IPv4 address of the web container,
# a Docker network address that changes whenever DDEV recreates the container,
# and it has no option to name another host. The desktop app saves whatever
# address it paired through, so mint the token with "t3 pair" and put it on an
# address that stays the same: the project URL through ddev-router by default.
pair_t3() {
  local base_url="" ttl="" label="ddev t3 pair"
  local output token expires pairing_url
  local -a pair_args

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base-url|--ttl|--label)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          echo "assistant-t3: $1 needs a value" >&2
          exit 1
        fi
        case "$1" in
          --base-url) base_url="$2" ;;
          --ttl) ttl="$2" ;;
          --label) label="$2" ;;
        esac
        shift 2
        ;;
      --base-url=*) base_url="${1#*=}"; shift ;;
      --ttl=*) ttl="${1#*=}"; shift ;;
      --label=*) label="${1#*=}"; shift ;;
      *)
        echo "assistant-t3: unknown pair option '$1'" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  if [ -z "${base_url}" ]; then
    resolve_ports
    base_url="https://$(project_hostname):${ASSISTANT_T3_HTTPS_PORT_RESOLVED}"
  fi
  base_url="${base_url%/}"
  validate_base_url "${base_url}"

  require_t3

  pair_args=(pair --base-dir "$(t3_runtime_home)" --label "${label}")
  if [ -n "${ttl}" ]; then
    pair_args+=(--ttl "${ttl}")
  fi

  if ! output="$(T3CODE_HOME="$(t3_runtime_home)" t3 "${pair_args[@]}" 2>&1)"; then
    printf '%s\n' "${output}" >&2
    echo "assistant-t3: \"t3 pair\" failed. Is T3 running? Check with \"ddev t3 status\", and start it with \"ddev t3 start\" in another terminal." >&2
    exit 1
  fi

  token="$(printf '%s\n' "${output}" | sed -n 's/^Token: //p' | head -n 1)"
  expires="$(printf '%s\n' "${output}" | sed -n 's/^Expires: //p' | head -n 1)"
  if [ -z "${token}" ]; then
    printf '%s\n' "${output}" >&2
    echo "assistant-t3: could not find the token in the \"t3 pair\" output above" >&2
    exit 1
  fi

  pairing_url="${base_url}/pair#token=${token}"

  cat <<EOF
Pair the T3 desktop app with this project. Open the app link, or add the
pairing URL as a remote environment:

  Pairing URL: ${pairing_url}
  App link: t3code://pair?pairingUrl=$(form_url_encode "${pairing_url}")
  Token: ${token}
EOF
  if [ -n "${expires}" ]; then
    echo "  Expires: ${expires}"
  fi
  cat <<EOF

The app saves ${base_url} and reconnects to it after restarts.
EOF
}

# Everything "t3 serve" needs before it runs, shared by the foreground "start"
# and the "daemon" that ASSISTANT_T3_AUTOSTART runs, so both start T3 the same
# way. Leaves the working directory at the app root and exports T3CODE_HOME.
prepare_serve() {
  require_t3

  check_node_version

  resolve_ports

  prepare_t3_home

  export T3CODE_HOME="${T3CODE_RUNTIME_HOME}"
  cd "${DDEV_APPROOT_DIR}"
  seed_project
}

print_urls() {
  local hostname direct_publish direct_bind_address direct_port

  hostname="$(project_hostname)"

  cat <<EOF
T3 URLs:
  http://${hostname}:${ASSISTANT_T3_HTTP_PORT_RESOLVED}
  https://${hostname}:${ASSISTANT_T3_HTTPS_PORT_RESOLVED}
EOF

  while read -r direct_publish; do
    [ -n "${direct_publish}" ] || continue
    direct_bind_address="${direct_publish%:*}"
    direct_bind_address="${direct_bind_address%:*}"
    direct_port="${direct_publish#"${direct_bind_address}":}"
    direct_port="${direct_port%:*}"
    case "${direct_bind_address}" in
      0.0.0.0|'[::]')
        echo "  http://<host address>:${direct_port} (direct, every interface, no TLS)"
        ;;
      *)
        echo "  http://${direct_bind_address}:${direct_port} (direct, no TLS)"
        ;;
    esac
  done <<EOF
$(read_direct_publishes)
EOF
}

serve_args() {
  SERVE_ARGS=(serve --mode web --host 0.0.0.0 --port "${ASSISTANT_T3_CONTAINER_PORT_RESOLVED}" --base-dir "${T3CODE_HOME}" --no-browser "$@")
}

# The supervisord program name DDEV gives the ASSISTANT_T3_AUTOSTART daemon.
DAEMON_PROGRAM="webextradaemons:assistant-t3"

# Prints the daemon's supervisord state (RUNNING, STOPPED, FATAL, ...), or
# nothing when autostart is off and supervisord has no such program.
daemon_state() {
  local output

  command -v supervisorctl >/dev/null 2>&1 || return 0
  output="$(supervisorctl status "${DAEMON_PROGRAM}" 2>/dev/null || true)"
  case "${output}" in
    *"no such"*|*"ERROR"*|'') return 0 ;;
  esac
  printf '%s\n' "${output}" | awk 'NR == 1 { print $2 }'
}

daemon_is_up() {
  case "$1" in
    RUNNING|STARTING|BACKOFF) return 0 ;;
  esac
  return 1
}

# True when something answers on the T3 container port, for a foreground T3.
port_answers() {
  (exec 3<>"/dev/tcp/127.0.0.1/${ASSISTANT_T3_CONTAINER_PORT_RESOLVED}") 2>/dev/null
}

print_daemon_hints() {
  cat <<'EOF'

T3 runs as a DDEV daemon because ASSISTANT_T3_AUTOSTART=true. It keeps running
after this terminal closes, and starts again with "ddev start".

  Logs: ddev logs -s web -f
  Pair the desktop app: ddev t3 pair
  Stop or restart it: ddev t3 stop, ddev t3 restart
EOF
}

# "t3 serve" prints a live pairing token, a pairing URL with that token and a
# QR code of it on every start, unless T3's own service launcher started it
# over IPC, which nothing else can request. DDEV sends daemon output to
# "ddev logs", so drop those lines there. "Connection string" names the web
# container's IP, which changes whenever DDEV recreates the container.
redact_pairing() {
  sed -u \
    -e '/^Token: /d' \
    -e '/^Pairing URL: /d' \
    -e '/^App link: /d' \
    -e '/^Connection string: /d' \
    -e '/^[[:space:]]*[█▀▄][█▀▄[:space:]]*$/d' \
    -e 's/^T3 Code server is ready\.$/&\nassistant-t3: pairing details are not logged here; run "ddev t3 pair" to pair a device./'
}

start_t3() {
  local state

  resolve_ports
  state="$(daemon_state)"
  if [ -n "${state}" ]; then
    if [ "${1:-}" = "--" ] && [ "$#" -gt 1 ]; then
      echo "assistant-t3: T3 runs as a daemon (ASSISTANT_T3_AUTOSTART=true), which takes no extra \"t3 serve\" arguments" >&2
      exit 1
    fi
    if daemon_is_up "${state}"; then
      echo "T3 is already running as a daemon (${state})."
    else
      supervisorctl start "${DAEMON_PROGRAM}" >/dev/null || true
      state="$(daemon_state)"
      if ! daemon_is_up "${state}"; then
        echo "assistant-t3: the T3 daemon did not start (${state:-unknown}). See \"ddev logs -s web\"." >&2
        exit 1
      fi
      echo "Started the T3 daemon."
    fi
    print_urls
    print_daemon_hints
    return 0
  fi

  prepare_serve
  print_urls

  cat <<EOF

To pair the desktop app, run "ddev t3 pair" in another terminal once T3 is
ready. Don't use T3's own "Connection string" and "Pairing URL" below: they name
the web container's IP, which changes whenever DDEV recreates the container.

Starting T3 in the web container. Press Ctrl-C to stop it.
EOF

  if [ "${1:-}" = "--" ]; then
    shift
  fi

  serve_args "$@"
  exec t3 "${SERVE_ARGS[@]}"
}

# Run by supervisord through the web_extra_daemons entry that
# ASSISTANT_T3_AUTOSTART=true renders in config.assistant-t3.local.yaml.
daemon_t3() {
  prepare_serve
  print_urls
  serve_args
  exec t3 "${SERVE_ARGS[@]}" > >(redact_pairing) 2>&1
}

require_daemon() {
  local state

  state="$(daemon_state)"
  if [ -z "${state}" ]; then
    echo "assistant-t3: T3 is not managed as a daemon. Stop a \"ddev t3 start\" with Ctrl-C in its terminal, or set ASSISTANT_T3_AUTOSTART=true (see the README)." >&2
    exit 1
  fi
}

stop_t3() {
  require_daemon
  supervisorctl stop "${DAEMON_PROGRAM}" >/dev/null
  echo "Stopped the T3 daemon. It starts again with \"ddev t3 start\" or \"ddev restart\"."
}

restart_t3() {
  local state

  require_daemon
  supervisorctl restart "${DAEMON_PROGRAM}" >/dev/null || true
  state="$(daemon_state)"
  if ! daemon_is_up "${state}"; then
    echo "assistant-t3: the T3 daemon did not start (${state:-unknown}). See \"ddev logs -s web\"." >&2
    exit 1
  fi
  echo "Restarted the T3 daemon."
}

status_t3() {
  local state

  resolve_ports
  state="$(daemon_state)"
  if [ -n "${state}" ]; then
    echo "T3 daemon (ASSISTANT_T3_AUTOSTART=true): ${state}"
    if [ "${state}" = "FATAL" ]; then
      echo "It exited too often to restart. See \"ddev logs -s web\", then run \"ddev t3 start\"."
    fi
    daemon_is_up "${state}" || return 0
  elif port_answers; then
    echo "T3 is running in the foreground of a \"ddev t3 start\"."
  else
    echo "T3 is not running. Start it with \"ddev t3 start\"."
    return 0
  fi
  print_urls
}

subcommand="${1:-help}"
case "${subcommand}" in
  start)
    shift
    start_t3 "$@"
    ;;
  pair)
    shift
    pair_t3 "$@"
    ;;
  status)
    status_t3
    ;;
  stop)
    stop_t3
    ;;
  restart)
    restart_t3
    ;;
  daemon)
    daemon_t3
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "assistant-t3: unknown command '${subcommand}'" >&2
    usage >&2
    exit 1
    ;;
esac
