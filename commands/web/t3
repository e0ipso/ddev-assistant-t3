#!/bin/bash

## Description: Manage T3 Code in the DDEV web container
## Usage: t3 start [-- <extra t3 serve args>]
## Example: "ddev t3 start"

#ddev-generated

set -euo pipefail

DDEV_CONFIG_DIR="${DDEV_CONFIG_DIR:-/mnt/ddev_config}"
DDEV_APPROOT_DIR="${DDEV_APPROOT_DIR:-/var/www/html}"

usage() {
  cat <<'EOF'
Usage:
  ddev t3 start [-- <extra t3 serve args>]
  ddev t3 help

Commands:
  start   Run "t3 serve" in the web container foreground
  help    Show this help
EOF
}

read_env_var() {
  local key="$1"
  local env_file="${DDEV_CONFIG_DIR}/.env.assistant-t3"

  [ -f "${env_file}" ] || return 0
  awk -v key="${key}" '
    BEGIN { FS = "=" }
    $1 == key {
      value = substr($0, index($0, "=") + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      gsub(/^"|"$/, "", value)
      gsub(/^'\''|'\''$/, "", value)
      print value
      exit
    }
  ' "${env_file}"
}

read_direct_publishes() {
  local compose_file="${DDEV_CONFIG_DIR}/docker-compose.assistant-t3.yaml"

  [ -f "${compose_file}" ] || return 0
  awk -F'"' '/^[[:space:]]*-[[:space:]]*"/ { print $2 }' "${compose_file}"
}

read_ddev_config_port() {
  local key="$1"
  local config_file="${DDEV_CONFIG_DIR}/config.assistant-t3.yaml"

  [ -f "${config_file}" ] || return 0
  awk -v key="${key}" '
    $1 == key ":" {
      print $2
      exit
    }
  ' "${config_file}"
}

validate_port() {
  local name="$1"
  local port="$2"

  case "${port}" in
    ''|*[!0-9]*)
      echo "assistant-t3: ${name} must be a numeric TCP port, got '${port}'" >&2
      exit 1
      ;;
  esac

  if [ "${port}" -lt 1 ] || [ "${port}" -gt 65535 ]; then
    echo "assistant-t3: ${name} must be between 1 and 65535, got '${port}'" >&2
    exit 1
  fi
}

calculate_default_ports() {
  local sitename="${DDEV_SITENAME:-${DDEV_PROJECT:-}}"

  if [ -z "${sitename}" ]; then
    echo "assistant-t3: DDEV_SITENAME is not available; cannot calculate default ports" >&2
    exit 1
  fi

  local hash offset
  hash="$(printf '%s' "${sitename}" | cksum | awk '{print $1}')"
  offset="$(( (hash % 4500) * 2 ))"
  ASSISTANT_T3_DEFAULT_HTTP_PORT="$(( 20000 + offset ))"
  ASSISTANT_T3_DEFAULT_HTTPS_PORT="$(( ASSISTANT_T3_DEFAULT_HTTP_PORT + 1 ))"
}

# Docker creates the T3 state volume owned by root. Hand its root to the web
# container user once, so T3 can write its state there.
ensure_state_dir_writable() {
  local state_dir="/mnt/ddev-global-cache/assistant-t3"

  [ -d "${state_dir}" ] || return 0
  [ -w "${state_dir}" ] && return 0
  if ! sudo -n chown "$(id -u):$(id -g)" "${state_dir}"; then
    echo "assistant-t3: ${state_dir} is not writable and changing its owner failed" >&2
    exit 1
  fi
}

prepare_t3_home() {
  local sitename="${DDEV_SITENAME:-${DDEV_PROJECT:-default}}"
  # DDEV mounts /mnt/ddev_config read-only. T3 saves settings.json by writing a
  # temp file next to the symlink target, so link to the writable app root copy.
  local t3_config_dir="${DDEV_APPROOT_DIR}/.ddev/t3"
  local t3_runtime_home="${ASSISTANT_T3_RUNTIME_DIR:-/mnt/ddev-global-cache/assistant-t3/${sitename}}"
  local t3_runtime_userdata="${t3_runtime_home}/userdata"
  local settings_file="${t3_config_dir}/settings.json"
  local settings_link="${t3_runtime_userdata}/settings.json"

  ensure_state_dir_writable
  mkdir -p "${t3_config_dir}" "${t3_runtime_userdata}"
  if [ ! -f "${settings_file}" ]; then
    cat > "${settings_file}" <<'EOF'
{
  "defaultThreadEnvMode": "local",
  "newWorktreesStartFromOrigin": false
}
EOF
  fi

  if [ -e "${settings_link}" ] && [ ! -L "${settings_link}" ]; then
    echo "assistant-t3: ${settings_link} exists and is not a symlink; refusing to hide user data" >&2
    exit 1
  fi

  ln -sfn "${settings_file}" "${settings_link}"
  T3CODE_RUNTIME_HOME="${t3_runtime_home}"
}

# Add the DDEV app root as a T3 project once per state volume, so a fresh T3
# opens on this project rather than an empty list. The marker keeps a project
# the user removed or archived from coming back: "t3 project add" would create
# a removed one again and unarchive an archived one. Deleting only T3's
# database leaves the marker behind, so that project is not added again.
# Call after T3CODE_HOME is exported: the npm launcher downloads its runtime
# there and ignores --base-dir. "t3 project add" exists since 0.0.16; on older
# versions, and on any other failure, warn and retry on the next start.
seed_project() {
  local marker="${T3CODE_HOME}/.ddev-project-seeded"
  local title="${DDEV_SITENAME:-${DDEV_PROJECT:-$(basename "${DDEV_APPROOT_DIR}")}}"
  local output

  [ -e "${marker}" ] && return 0

  # T3 prints its errors on stdout, so capture both streams.
  if output="$(t3 project add "${DDEV_APPROOT_DIR}" --title "${title}" --base-dir "${T3CODE_HOME}" --log-level warn 2>&1)"; then
    echo "assistant-t3: added ${DDEV_APPROOT_DIR} to T3 as project '${title}'"
    touch "${marker}"
  # T3 prints "An active project already exists for '<path>'." when the
  # project is there already. If a release rewords it, this warns every start.
  elif [[ "${output}" == *"already exists"* ]]; then
    touch "${marker}"
  else
    echo "assistant-t3: could not add ${DDEV_APPROOT_DIR} to T3 as a project; will retry on the next start" >&2
    printf '%s\n' "${output%%$'\n'*}" >&2
  fi
}

# T3 only uses Node.js to run its npm launcher, so check the container's Node.js
# against the engines field of the installed t3 package rather than a list kept
# here. Releases 0.0.41 to 0.1.0 don't declare one, so they get no check. If
# the check itself can't run, let T3 start.
check_node_version() {
  node - "$(npm root --global 2>/dev/null)" <<'EOF' || exit 1
const fs = require("fs");
const path = require("path");
const npmRoot = process.argv[2];
let pkg, semver;
try {
  pkg = JSON.parse(fs.readFileSync(path.join(npmRoot, "t3", "package.json"), "utf8"));
  semver = require(path.join(npmRoot, "npm", "node_modules", "semver"));
} catch (error) {
  console.error(`assistant-t3: could not check which Node.js versions T3 supports, so starting it anyway: ${error.message.split("\n")[0]}`);
  process.exit(0);
}
const range = pkg.engines && pkg.engines.node;
if (range && !semver.satisfies(process.versions.node, range, { includePrerelease: true })) {
  console.error(`assistant-t3: T3 ${pkg.version} needs Node.js ${range}, but the web container has ${process.version}. Change nodejs_version in .ddev/config.yaml and run "ddev restart".`);
  process.exit(1);
}
EOF
}

start_t3() {
  if ! command -v t3 >/dev/null 2>&1; then
    cat >&2 <<'EOF'
assistant-t3: T3 is not available in the web container.

Run "ddev restart" to rebuild the web image after installing the add-on.
If the rebuild already ran, inspect the web image build output for the T3 npm install failure.
EOF
    exit 1
  fi

  check_node_version

  calculate_default_ports

  local env_container_port env_http_port env_https_port
  local config_container_port config_http_port config_https_port
  local container_port http_port https_port hostname
  local direct_publish direct_bind_address direct_port

  env_container_port="$(read_env_var ASSISTANT_T3_CONTAINER_PORT)"
  env_http_port="$(read_env_var ASSISTANT_T3_HTTP_PORT)"
  env_https_port="$(read_env_var ASSISTANT_T3_HTTPS_PORT)"

  config_container_port="$(read_ddev_config_port container_port)"
  config_http_port="$(read_ddev_config_port http_port)"
  config_https_port="$(read_ddev_config_port https_port)"

  container_port="${config_container_port:-${env_container_port:-3773}}"
  http_port="${config_http_port:-${env_http_port:-${ASSISTANT_T3_DEFAULT_HTTP_PORT}}}"
  https_port="${config_https_port:-${env_https_port:-${ASSISTANT_T3_DEFAULT_HTTPS_PORT}}}"

  validate_port "ASSISTANT_T3_CONTAINER_PORT" "${container_port}"
  validate_port "ASSISTANT_T3_HTTP_PORT" "${http_port}"
  validate_port "ASSISTANT_T3_HTTPS_PORT" "${https_port}"

  if [ "${http_port}" = "${https_port}" ]; then
    echo "assistant-t3: ASSISTANT_T3_HTTP_PORT and ASSISTANT_T3_HTTPS_PORT must differ" >&2
    exit 1
  fi

  prepare_t3_home

  hostname="${DDEV_SITENAME:-${DDEV_PROJECT:-}}.ddev.site"
  if [ "${hostname}" = ".ddev.site" ]; then
    echo "assistant-t3: DDEV_SITENAME is not available; cannot print project URLs" >&2
    exit 1
  fi

  cat <<EOF
T3 URLs:
  http://${hostname}:${http_port}
  https://${hostname}:${https_port}
EOF

  while read -r direct_publish; do
    [ -n "${direct_publish}" ] || continue
    direct_bind_address="${direct_publish%:*}"
    direct_bind_address="${direct_bind_address%:*}"
    direct_port="${direct_publish#"${direct_bind_address}":}"
    direct_port="${direct_port%:*}"
    case "${direct_bind_address}" in
      0.0.0.0|'[::]')
        echo "  http://<host address>:${direct_port} (direct, every interface, no TLS)"
        ;;
      *)
        echo "  http://${direct_bind_address}:${direct_port} (direct, no TLS)"
        ;;
    esac
  done <<EOF
$(read_direct_publishes)
EOF

  cat <<EOF

Starting T3 in the web container. Press Ctrl-C to stop it.
EOF

  if [ "${1:-}" = "--" ]; then
    shift
  fi

  export T3CODE_HOME="${T3CODE_RUNTIME_HOME}"
  cd "${DDEV_APPROOT_DIR}"
  seed_project
  exec t3 serve --mode web --host 0.0.0.0 --port "${container_port}" --base-dir "${T3CODE_HOME}" --no-browser "$@"
}

subcommand="${1:-help}"
case "${subcommand}" in
  start)
    shift
    start_t3 "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "assistant-t3: unknown command '${subcommand}'" >&2
    usage >&2
    exit 1
    ;;
esac
